# ==============================================================================
# Environment Configuration Example
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# ==============================================================================

# Port the Express server listens on (Render automatically supplies PORT in production)
PORT=3000

# File path to the SQLite database
# For persistent hosting on Render, mount a persistent disk and point to its mount path (e.g., /var/data/cleanup_requests.db)
DATABASE_PATH=./cleanup_requests.db

# Application Environment (development | production | test)
NODE_ENV=development
